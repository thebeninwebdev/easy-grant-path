# Server-only MongoDB connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Used by Better Auth to sign sessions. Generate a long random value and keep it server-only.
BETTER_AUTH_SECRET=
# Optional public origin for deployed environments, for example https://app.example.com
BETTER_AUTH_URL=http://localhost:3000

# Resend sends the email-verification message after sign-up. The From address
# must belong to a domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=EasyGrantPath <onboarding@your-verified-domain.com>

# Shared only by the deployment and GitHub Actions; never expose this to the browser.
SYNC_SECRET=<generate-a-long-random-secret>
# Optional override, primarily useful for development/testing.
GRANTS_GOV_BASE_URL=https://api.grants.gov

# Optional server-side structured extraction for opportunity URL imports.
GEMINI_API_KEY=
AI_GENERATION_MODEL=gemini-2.5-flash
MAX_PAGES_PER_IMPORT=3
CRAWL_TIMEOUT_MS=15000
MAX_PAGE_BYTES=2000000

# Optional dedicated Serper search provider (Gemini grounded research remains the fallback).
SERPER_API_KEY=


# Private Vercel Blob verification storage. Keep all values server-only.
# Production Vercel deployments may provide OIDC variables automatically.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Flutterwave Standard v3. Use TEST keys locally and in Vercel Preview, and LIVE
# keys only in Vercel Production. The public key is optional for hosted checkout.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
# Public application origin. HTTP is accepted only for localhost test mode.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paid Proposal Review. Integer amount in the currency's smallest unit.
PROPOSAL_REVIEW_PRICE_MINOR=
PROPOSAL_REVIEW_CURRENCY=
# Recipient for verified paid-service notifications.
ADMIN_NOTIFICATION_EMAIL=